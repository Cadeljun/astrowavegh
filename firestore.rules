rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         isSuperAdmin());
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == 'junioraquils143@gmail.com' ||
         (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'SUPER_ADMIN'));
    }

    function isOrganizer() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organizer';
    }

    function isTalent() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'talent';
    }

    // ── BOOKINGS ────────────────────────────────────────────────────
    match /bookings/{id} {
      allow read: if isAdmin() || 
                   (isOrganizer() && resource.data.organizerId == request.auth.uid) ||
                   (isTalent() && resource.data.talentId == request.auth.uid);
      allow create: if isOrganizer() || isAdmin();
      allow update: if isTalent() && resource.data.talentId == request.auth.uid || 
                     isOrganizer() && resource.data.organizerId == request.auth.uid || 
                     isAdmin();
      allow delete: if isAdmin();
    }

    // ── EVENTS ──────────────────────────────────────────────────────
    match /events/{id} {
      allow read: if true;
      allow create: if isOrganizer() || isAdmin();
      allow update: if isOrganizer() && resource.data.organizerId == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    // ── TALENT ──────────────────────────────────────────────────────
    match /talent/{id} {
      allow read: if true;
      allow create: if isTalent() || isAdmin();
      allow update: if isTalent() && resource.data.userId == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    match /talent_profiles/{id} {
      allow read: if true;
      allow create: if isTalent() || isAdmin();
      allow update: if isTalent() && resource.data.userId == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    // ── PUBLIC FORMS ────────────────────────────────────────────────
    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /waitlist/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /talent_inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── RATINGS ─────────────────────────────────────────────────────
    match /ratings/{id} {
      allow read: if true;
      allow create: if isOrganizer() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── MATCHES ─────────────────────────────────────────────────────
    match /matches/{eventId} {
      allow read: if isOrganizer() || isAdmin();
      allow write: if isAdmin();
    }

    // ── ANALYTICS ──────────────────────────────────────────────────
    match /analytics_events/{id} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // ── USERS ──────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid || isAdmin();
      allow delete: if isAdmin();
    }

    match /organizer_profiles/{id} {
      allow read: if isAuthenticated();
      allow create: if isOrganizer() || isAdmin();
      allow update: if isOrganizer() && resource.data.userId == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    // ── NOTIFICATIONS ──────────────────────────────────────────────
    match /notifications/{id} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
    }

    // ── ADMIN ONLY ──────────────────────────────────────────────────
    match /uploads/{id} {
      allow read, write: if isAdmin();
    }

    match /seed_logs/{id} {
      allow read, write: if isAdmin();
    }

    match /platform_events/{id} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── CMS ──────────────────────────────────────────────────────────
    match /cms_settings/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /cms_content/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /cms_sections/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /cms_seo/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

  }
}
