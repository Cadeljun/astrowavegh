# Environment Variables for AstroWave
# Copy this to .env.local and fill in your values

# Firebase Configuration (Client-side - safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Server-side - NEVER expose)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=dmd5bq3va
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dmd5bq3va
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=astrowave_preset

# Admin Configuration (comma-separated emails)
ADMIN_EMAILS=junioraquils143@gmail.com
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=junioraquils143@gmail.com

# Google AI / Genkit (for AI features)
GOOGLE_GENAI_API_KEY=
